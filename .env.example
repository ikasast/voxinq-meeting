# Voxinq environment — copy to `.env` and adjust.
#
# Almost everything here is optional. Required: DATABASE_URL, plus POSTGRES_PASSWORD on Docker.
# Each block says which install it applies to, because a few settings belong to only one.
#
# Docker:  edit this file, then `docker compose up -d`.
# Native:  `scripts/setup` copies this file and asks for DATABASE_URL.
#
# Full walkthrough, entry by entry: docs/setup.md

# === Required ========================================================================
# PostgreSQL connection string.
#
# Native install — the host running PostgreSQL, as below.
# Docker Compose — the `db` service, NOT localhost. Inside a container, localhost is the
# container itself, so the app cannot find the database. Use the same password you set for
# POSTGRES_PASSWORD below:
#
#   DATABASE_URL="postgresql://voxinq:YOUR-PASSWORD@db:5432/voxinq"
#
DATABASE_URL="postgresql://voxinq:PASSWORD@localhost:5432/voxinq"

# === Docker Compose only =============================================================
# Password for the bundled PostgreSQL container. Compose refuses to start without it.
# You are inventing it here — it does not have to match anything that already exists.
# POSTGRES_PASSWORD="change-me"
#
# Hugging Face token. Not needed for anything Voxinq ships: speaker separation moved to
# ungated models. Set this only if you point WHISPER_MODEL at a gated repository.
# HF_TOKEN=""
#
# Where the *browser* reaches the STT service. Defaults to ws://localhost:<STT_PORT>/ws,
# which is right when you browse from the same machine. To record from a phone, set the
# address that phone will use. Applied on `docker compose up -d` — no rebuild.
# STT_WS_URL="wss://myhost.tailnet.ts.net:8443/ws"
#
# Host ports. Only needed when something already uses one — a local PostgreSQL on 5432 is
# the usual case, and compose fails to start rather than sharing it. The containers reach
# each other by name regardless, so these only affect access from the host.
# WEB_PORT="3000"
# STT_PORT="8000"
# DB_PORT="127.0.0.1:5432"
# OLLAMA_PORT="127.0.0.1:11434"
#
# Pin both images to one release instead of following the newest.
# VOXINQ_VERSION="v1.4.1"

# === Native install only =============================================================
# STT WebSocket URL the *browser* connects to.
# ⚠ Compiled into the bundle at build time — rebuild after changing.
# Docker installs ignore this and use STT_WS_URL above, which is read at request time.
# Local:      ws://localhost:8000/ws
# Tailscale:  wss://<host>.<tailnet>.ts.net:8443/ws
NEXT_PUBLIC_STT_WS_URL="ws://localhost:8000/ws"

# === Both ============================================================================
# Optional password login. Unset = anyone who can reach the address is in, which is fine
# while that is only your own machine. Set it before exposing the app beyond your network.
# APP_PASSWORD="change-me"

# Secret for the auth cookie — set your own random string when using APP_PASSWORD.
# APP_SESSION_SECRET="generate-a-long-random-string"

# `tailscale` (default): non-tailnet access is login-gated and read-only.
# `lan`: any reachable client is trusted (home LAN without Tailscale).
# NETWORK_MODE="tailscale"

# Runtime app settings (Whisper model, glossary, LLM provider, minutes options, API keys)
# live in `settings.json`, editable in the UI under Settings — not here.
