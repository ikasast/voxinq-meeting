// Voxinq data model.
// Meeting 1 - n Transcript / MeetingSummary.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Meeting {
  id                        String    @id @default(cuid())
  title                     String
  description               String?   @map("description") // meta info such as the meeting's purpose/contents
  sttLanguage               String?   @map("stt_language") // this meeting's STT language "auto"|"ja"|"en" (null = settings default)
  whisperModel              String?   @map("whisper_model") // this meeting's transcription model (null = settings default)
  speakerLabels             String?   @map("speaker_labels") // speaker key -> display name map (stringified JSON object)
  summaryStatus             String?   @map("summary_status") // minutes generation state: processing | done | error
  summaryError              String?   @map("summary_error") // why the last generation failed (shown in the UI; cleared on the next run)
  seriesId                  String?   @map("series_id") // recurring-series membership (null = standalone)
  diarizationEmbeddings     String?   @map("diarization_embeddings") // per-cluster voice embeddings from the last diarization run (JSON: {"speaker0": [floats]})
  diarizationEmbeddingModel String?   @map("diarization_embedding_model") // which model produced them (null = pyannote, i.e. before there was a choice) — see lib/embedding-models.ts
  embedding                 String?   @map("embedding") // unused: leftover from the removed AI (semantic) search
  embeddingModel            String?   @map("embedding_model") // unused: leftover from the removed AI (semantic) search
  // Set when a meeting is put in the diary before it happens. `startedAt` is set to the same
  // moment so the date on screen is the meeting's, and is corrected to the real one when the
  // recording ends. Null on everything created the old way: recorded first, filed after.
  scheduledAt               DateTime? @map("scheduled_at")
  startedAt                 DateTime  @default(now()) @map("started_at")
  endedAt                   DateTime? @map("ended_at")
  recordedMs                Int?      @map("recorded_ms") // actual recorded audio length in ms (set on end from the WAV); null for older meetings
  deletedAt                 DateTime? @map("deleted_at") // trash (soft delete). null = normal. purged after a while
  archivedAt                DateTime? @map("archived_at") // archived: hidden from the list, still searchable, kept in DB
  createdAt                 DateTime  @default(now()) @map("created_at")
  updatedAt                 DateTime  @updatedAt @map("updated_at")

  jobs         Job[]
  transcripts  Transcript[]
  summaries    MeetingSummary[]
  tags         Tag[]
  participants MeetingParticipant[]
  series       Series?              @relation(fields: [seriesId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([deletedAt])
  @@index([archivedAt])
  @@index([seriesId])
  @@map("meetings")
}

// A recurring meeting series ("weekly sync" etc.). When generating minutes for a
// meeting in a series, the previous meeting's minutes are fed to the LLM as
// reference-only context so follow-up topics are interpreted correctly.
/// Work that needs the GPU, in the order it will get it.
///
/// Before this there were two job systems and no queue: the STT service kept its runs in
/// process memory, minutes generation ran in `after()` with a column for a flag, and they
/// avoided each other by each refusing to start while the other said it was busy. That
/// arbitration was spread across the UI, the STT service and this app -- three places holding
/// one decision -- and its only outcome was a disabled button.
///
/// The table is the queue. It survives a restart, it can be ordered, and one dispatcher reads
/// it, so "what runs next" has a single answer that can be shown to the person waiting.
model Job {
  id         String    @id @default(cuid())
  /// What to run. See JOB_KINDS in lib/queue/types.ts.
  kind       String
  /// The meeting this is for, when it is about one. Null for work that is not.
  meetingId  String?   @map("meeting_id")
  /// queued -> running -> done | error, or cancelled from either of the first two.
  status     String    @default("queued")
  /// Order among queued jobs; ties break by createdAt, so the default 0 is FIFO. Reordering
  /// writes explicit values.
  position   Int       @default(0)
  /// What it is expected to occupy on the GPU, in MB. Zero for work that does not touch it --
  /// recognition sent to an endpoint, minutes written by a cloud model, sherpa diarization.
  vramMb     Int       @default(0) @map("vram_mb")
  /// Arguments for the run, as JSON. Read when the job starts, not when it is queued: a
  /// transcript edited while the job waited should be the one the minutes are written from.
  params     String    @default("{}")
  attempts   Int       @default(0)
  /// Why it failed, or what happened to it -- "interrupted by a recording", "restarted".
  detail     String?
  createdAt  DateTime  @default(now()) @map("created_at")
  startedAt  DateTime? @map("started_at")
  finishedAt DateTime? @map("finished_at")

  meeting Meeting? @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@index([status, position])
  @@index([meetingId])
  @@map("jobs")
}

model Series {
  id            String   @id @default(cuid())
  name          String   @unique
  summaryFormat String?  @map("summary_format") // per-series minutes format (overrides the global setting)
  sttGlossary   String?  @map("stt_glossary") // per-series terms for Whisper initial_prompt (appended to the global glossary)
  createdAt     DateTime @default(now()) @map("created_at")

  meetings Meeting[]

  @@map("series")
}

// User-defined meeting tags (unique by name). Many-to-many with meetings.
model Tag {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  meetings Meeting[]

  @@map("tags")
}

// Enrolled voice profiles: one mean speaker embedding (voiceprint) per named person.
// Enrolled from a diarized meeting's clusters; matched against future diarization runs
// to auto-name recurring speakers.
model SpeakerProfile {
  id              String   @id @default(cuid())
  name            String   @unique
  embedding       String // JSON float array (speaker centroid), averaged over all enrollments
  // Which model produced `embedding`. Two models can share a dimension and mean entirely
  // different things, so without this a model change makes every profile stop matching with
  // nothing to explain why. Null = enrolled before this was recorded, i.e. pyannote.
  embeddingModel  String?  @map("embedding_model")
  sampleCount     Int      @default(1) @map("sample_count") // enrollments folded into `embedding`
  sourceMeetingId String?  @map("source_meeting_id") // meeting the profile was last enrolled from
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("speaker_profiles")
}

model Transcript {
  id           String   @id @default(cuid())
  meetingId    String   @map("meeting_id")
  speakerType  String   @map("speaker_type") // 'self' | 'partner-0' | 'partner-1' | ...
  text         String
  translation  String? // Japanese translation of a non-Japanese utterance (null = none/not needed)
  // Where this utterance sits in the recording. Null on rows written before this was stored, and
  // on any row whose utterance was not saved to a WAV; the player falls back to segments.json.
  audioStartMs Int?     @map("audio_start_ms")
  audioEndMs   Int?     @map("audio_end_ms")
  createdAt    DateTime @default(now()) @map("created_at")

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@index([meetingId, createdAt])
  @@map("transcripts")
}

model MeetingSummary {
  id          String   @id @default(cuid())
  meetingId   String   @map("meeting_id")
  summaryText String   @map("summary_text")
  provider    String? // LLM provider used for this version (recorded at generation time)
  model       String? // LLM model used for this version
  createdAt   DateTime @default(now()) @map("created_at")

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@index([meetingId, createdAt])
  @@map("meeting_summaries")
}

// Who was in the meeting, which is not the same question as whose voice is in the recording.
//
// `speaking` separates them: someone can attend and never say anything, and unticking them
// before diarization tells the diarizer how many voices to expect without removing them from
// the record of who was there. It also narrows which voice profiles are candidates for
// automatic naming, so a name cannot be attached to someone who was not in the room.
//
// A name rather than a link to SpeakerProfile: participants are typed freely, most meetings
// have people who have never been enrolled, and profile names are unique anyway — so a
// participant whose name matches a profile gains the voiceprint behaviour automatically, and
// keeps it if the profile is enrolled later.
model MeetingParticipant {
  id        String   @id @default(cuid())
  meetingId String   @map("meeting_id")
  name      String
  speaking  Boolean  @default(true) // expected to appear in the audio
  position  Int      @default(0) // display order, as entered
  createdAt DateTime @default(now()) @map("created_at")

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@unique([meetingId, name])
  @@index([meetingId])
  @@map("meeting_participants")
}
