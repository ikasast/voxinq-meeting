<?xml version="1.0" encoding="utf-8"?>
<!-- Long-press the app icon to point the app at another server. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutId="change_server"
        android:shortcutShortLabel="@string/change_server">
        <intent
            android:action="io.github.ikasast.voxinq.CHANGE_SERVER"
            android:targetClass="io.github.ikasast.voxinq.MainActivity"
            android:targetPackage="io.github.ikasast.voxinq" />
    </shortcut>
</shortcuts>
