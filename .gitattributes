# Normalize to LF inside the repo (avoids line-ending diffs between Windows/Ubuntu)
* text=auto eol=lf

# Windows-only scripts keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
*.vbs text eol=crlf

# Do not convert binaries
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.mp3 binary
*.wav binary

# Not in the release archive (`git archive`, which is what the distributable tarball is built
# from). These are for people working on Voxinq, not for running it: excluding them takes the
# download from ~9 MB to ~1 MB, most of it screenshots.
docs export-ignore
tests export-ignore
.github export-ignore
.gitattributes export-ignore
.gitignore export-ignore
AGENTS.md export-ignore
CLAUDE.md export-ignore
Dockerfile export-ignore
docker-compose.yml export-ignore
docker-compose.build.yml export-ignore
docker-compose.cpu.yml export-ignore
docker-compose.external-ollama.yml export-ignore
